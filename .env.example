# Gmail SMTP (used by all contact forms and cron jobs)
GMAIL_USER=notifications@gs-emobility.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Google Search Console verification
# Get this token from: https://search.google.com/search-console
# → Add property → HTML tag method → copy the content= value
GOOGLE_SITE_VERIFICATION=

# Anthropic API (weekly article + competitive report crons)
ANTHROPIC_API_KEY=sk-ant-...

# Unsplash (article hero images — optional, gracefully omitted if missing)
UNSPLASH_ACCESS_KEY=

# Vercel Cron authentication (any random secret string)
CRON_SECRET=

# Resend (transactional email for contact, book-visit, partner-site forms)
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_...

# Supabase — Project Portal (external partner access at /portal)
# Get these from Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Investor page password gate (middleware checks this against the cookie)
# Set to any strong random string; share with investors via secure channel
INVESTORS_ACCESS_TOKEN=
